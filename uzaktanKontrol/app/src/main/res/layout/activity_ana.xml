<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".AnaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Modern App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="12dp"
            android:background="@color/surface"
            app:navigationIcon="@drawable/ic_menu"
            app:title="DeskMate"
            app:titleTextColor="@color/on_surface"
            app:elevation="1dp"/>

        <!-- Device Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/gear"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/primary_500"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/txt_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="My Desktop PC"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/state_indicator"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/circle_connected"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/txt_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connected"
                            android:textColor="@color/connected_green"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/txt_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Last seen: 2 min ago"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp"
                            android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scrollable Actions -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Volume Control -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🎚️ Volume Control"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- Mute -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/volume_mute"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/volume_mute"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mute"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Volume Down -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/volume_down"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/volume_down"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Decrease"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Volume Up -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/volume_up"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/volume_up"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Increase"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Screen Control -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🖥️ Screen Control"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- Decrease Brightness -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/screen_mins"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/screen_mins"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Decrease"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Increase Brightness -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/screen_plus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/screen_plus"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Increase"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Apps -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/primary_50">

                                <LinearLayout
                                    android:id="@+id/btn_apps"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="@drawable/ripple_primary">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/appss"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Applications"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Power Control -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⚡ Power Control"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <!-- Lock -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/lock"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/padlock"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Lock"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Sleep -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/sleep"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/sleep"
                                        app:tint="@color/neutral_600"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sleep"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Restart -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/restart"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/restart"
                                        app:tint="@color/warning"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Restart"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Shutdown -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/surface_variant">

                                <LinearLayout
                                    android:id="@+id/shutdown"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="?attr/selectableItemBackground">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/shutdown"
                                        app:tint="@color/error"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Shutdown"
                                        android:textColor="@color/error"
                                        android:textSize="11sp"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Camera Control -->
                <!-- 🔹 بطاقة التحكم بالكاميرا (كاملة + مرتبة + مثل باقي الأقسام) -->
                <!-- 🔹 قسم التحكم بالكاميرا (منسق + الأزرار داخل الكروت) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- العنوان -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📷 Camera Control"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"/>

                        <!-- الصف الرئيسي للأزرار -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Open Camera -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_variant">

                                    <LinearLayout
                                        android:id="@+id/open_camera"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="?attr/selectableItemBackground">

                                        <ImageView
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:src="@drawable/camera"
                                            app:tint="@color/neutral_600"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Open"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                            <!-- Screenshot -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_variant">

                                    <LinearLayout
                                        android:id="@+id/screenShot"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="?attr/selectableItemBackground">

                                        <ImageView
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:src="@drawable/screenshot"
                                            app:tint="@color/neutral_600"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Screenshot"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                            <!-- Record -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_variant">

                                    <LinearLayout
                                        android:id="@+id/recShot"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="?attr/selectableItemBackground">

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:src="@drawable/recshot"
                                            app:tint="@color/neutral_600"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Record"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                            <!-- Gallery -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/primary_50">

                                    <LinearLayout
                                        android:id="@+id/btn_gallery"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="@drawable/ripple_primary">

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:src="@drawable/folder"
                                            app:tint="@color/neutral_600"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Gallery"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 🔻 يظهر فقط بعد فتح الكاميرا -->
                        <LinearLayout
                            android:id="@+id/camera_controls"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="16dp">

                            <!-- Capture -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_variant">

                                    <LinearLayout
                                        android:id="@+id/capture_image_btn"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="?attr/selectableItemBackground">

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:src="@drawable/capture_image"
                                            app:tint="@color/primary_500"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Capture"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>

                            <!-- Close Camera -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_margin="4dp">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="72dp"
                                    android:layout_height="72dp"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_variant">

                                    <LinearLayout
                                        android:id="@+id/close_camera_btn"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp"
                                        android:background="?attr/selectableItemBackground">

                                        <ImageView
                                            android:layout_width="28dp"
                                            android:layout_height="28dp"
                                            android:src="@drawable/close_camera"
                                            app:tint="@color/error"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Close"
                                            android:textSize="11sp"
                                            android:textColor="@color/on_surface_variant"
                                            android:layout_marginTop="4dp"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:itemIconTint="@color/on_surface_variant"
        app:itemTextColor="@color/on_surface"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header"/>

    <!-- Loading Overlay -->
    <include layout="@layout/loading_overlay"/>

</androidx.drawerlayout.widget.DrawerLayout>
