<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/neutral_200"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Image Container -->
        <FrameLayout
            android:id="@+id/image_container"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@color/neutral_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Image -->
            <ImageView
                android:id="@+id/image_item"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Gallery image"/>

            <!-- Overlay Gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/image_overlay_gradient"
                android:layout_gravity="bottom"/>

            <!-- Date Badge -->
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 15, 2024"
                android:textSize="11sp"
                android:textColor="@color/on_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/date_badge"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"/>

            <!-- Type Badge -->
            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAMERA"
                android:textSize="10sp"
                android:textColor="@color/on_primary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/type_badge"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"/>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary_500"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Image Name -->
        <TextView
            android:id="@+id/tv_img_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="landscape_photo_001.jpg"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/image_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>